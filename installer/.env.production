GARAGE_LPR_ENVIRONMENT=production
GARAGE_LPR_HOST=127.0.0.1
GARAGE_LPR_PORT=8080
GARAGE_LPR_LOG_LEVEL=INFO
GARAGE_LPR_DATABASE_URL=sqlite:///./runtime/data/garage_lpr.db
GARAGE_LPR_LOG_DIRECTORY=./runtime/logs
GARAGE_LPR_SNAPSHOT_DIRECTORY=./runtime/snapshots
GARAGE_LPR_SECRET_KEY_PATH=./runtime/data/camera-secrets.key
GARAGE_LPR_CORS_ORIGINS=[]
GARAGE_LPR_SECURE_COOKIES=false
GARAGE_LPR_AUTO_MIGRATE=true
