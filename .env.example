GARAGE_LPR_ENVIRONMENT=development
GARAGE_LPR_HOST=127.0.0.1
GARAGE_LPR_PORT=8080
GARAGE_LPR_LOG_LEVEL=INFO
# Source installs resolve relative paths from the repository root. The Windows EXE
# resolves mutable paths from C:\ProgramData\GarageLPR, never from process cwd.
GARAGE_LPR_DATABASE_URL=sqlite:///./runtime/data/garage_lpr.db
GARAGE_LPR_SECRET_KEY_PATH=./runtime/data/camera-secrets.key
GARAGE_LPR_MAX_ACTIVE_CAMERAS=1
GARAGE_LPR_PREVIEW_JPEG_QUALITY=75
GARAGE_LPR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GARAGE_LPR_SESSION_COOKIE_NAME=garage_lpr_session
GARAGE_LPR_CSRF_COOKIE_NAME=garage_lpr_csrf
GARAGE_LPR_SESSION_TTL_HOURS=12
GARAGE_LPR_SECURE_COOKIES=false
GARAGE_LPR_LOGIN_MAX_ATTEMPTS=5
GARAGE_LPR_LOGIN_LOCK_SECONDS=60

# HTTPS terminasyonu kullaniliyorsa true yapin. Yerel HTTP'de false kalmalidir.
# GARAGE_LPR_SECURE_COOKIES=true
